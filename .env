# ──────────────────────────────────────────────────────────
# NeuroRoute — Environment Configuration
# ──────────────────────────────────────────────────────────

# Gateway
GATEWAY_PORT=8000
SMART_ROUTING=false

# Workers
WORKER_1_PORT=8001
WORKER_2_PORT=8002
WORKER_3_PORT=8003
WORKER_4_PORT=8004
WORKER_5_PORT=8005

# ML Service
ML_SERVICE_PORT=8050
ML_SERVICE_URL=http://ml_service:8050
ML_PREDICT_TIMEOUT_MS=50

# Logging
LOG_LEVEL=info
TRAFFIC_LOG_PATH=/data/traffic.csv
